# Copiar a .env y completar. El .env real nunca se versiona (INTEGRATIONS.md §6).
# tsx no carga .env solo: cargarlo explícitamente en cada script suelto (CLAUDE.md §2).

# Cadena de conexión a MySQL del slot de Hostinger. Panel de Hostinger → Bases de datos → Remote MySQL.
DATABASE_URL=mysql://usuario:clave@host:3306/base

# URL pública del sitio en producción, usada para canonical, JSON-LD y sitemaps.
SITE_URL=https://moto.com.py

# true hasta superar 150 publicaciones vivas de >= 5 comercios (DATA_SEEDING.md §1, §3). Lo apaga el propietario.
SITE_NOINDEX=true

# Datos del tenant en VenderCRM. Los entrega el propietario cuando el tenant esté configurado (DECISIONS.md S-6).
VENDERCRM_URL=
VENDERCRM_API_KEY=

# Backend de almacenamiento de imágenes (ADR-16). "local" en fase 1.
STORAGE_DRIVER=local
# Ruta absoluta en el disco del slot de Hostinger donde se guardan las imágenes subidas.
STORAGE_LOCAL_PATH=/home/.../uploads

# Sal para hashear IPs antes de guardarlas (listing_events.ip_hash, LEGAL_AND_COMPLIANCE.md). Generar con una cadena aleatoria larga, una única vez.
IP_HASH_SALT=

# Secreto para firmar la cookie de sesión del admin (ADMIN_SPEC.md §1). Generar con una cadena aleatoria larga, una única vez.
SESSION_SECRET=

# SMTP para notificaciones (avisadores de búsqueda, alertas de admin). Proveedor de correo del propietario.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Número de WhatsApp general del sitio (contacto, no el de un vendedor), formato E.164.
WHATSAPP_SITE_NUMBER=
