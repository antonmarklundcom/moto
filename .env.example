# Copiar a .env y completar. El .env real nunca se versiona (INTEGRATIONS.md §6).
# tsx no carga .env solo: cargarlo explícitamente en cada script suelto (CLAUDE.md §2).

# Cadena de conexión a MySQL del slot de Hostinger. Panel de Hostinger → Bases de datos → Remote MySQL.
# Parámetros opcionales que se respetan: ?ssl=true y ?charset=utf8mb4.
DATABASE_URL=mysql://usuario:clave@host:3306/base

# Sólo desarrollo y sesiones de Claude: base aparte para las pruebas de integración
# (npm run test:int). Nunca apunta a producción. En el slot de Hostinger no existe.
TEST_DATABASE_URL=

# URL pública del sitio en producción, usada para canonical, JSON-LD y sitemaps.
SITE_URL=https://moto.com.py

# Indexación global (ADR-26). Tres modos:
#   true    → todo noindex (valor por defecto, y el que se usa si falta o es inválido)
#   content → guías y páginas estáticas indexables; inventario y páginas programáticas noindex
#   false   → rigen las reglas normales de umbral (SEO_ARCHITECTURE.md §2.1)
# Pasar a content o false es decisión del propietario (DATA_SEEDING.md §3), nunca de una sesión.
SITE_NOINDEX=true

# Datos del tenant en VenderCRM. Los entrega el propietario cuando el tenant esté configurado (DECISIONS.md S-6).
# Si faltan, el lead igual se guarda (crm_status=pending) y el job de reintento lo envía cuando existan.
# VENDERCRM_URL también se permite en la CSP (next.config.ts) para cargar vc-attribution.js.
VENDERCRM_URL=
VENDERCRM_API_KEY=

# Backend de almacenamiento de imágenes (ADR-16). "local" en fase 1.
STORAGE_DRIVER=local
# Ruta absoluta donde se guardan las imágenes subidas. Vacío = ~/moto-uploads (se crea sola, fuera de la app).
STORAGE_LOCAL_PATH=

# Sal para hashear IPs antes de guardarlas (listing_events.ip_hash, LEGAL_AND_COMPLIANCE.md). Generar con una cadena aleatoria larga, una única vez.
IP_HASH_SALT=

# Proxies de confianza delante de la app (para leer la IP real de X-Forwarded-For). 1 = sólo Hostinger; 2 si se agrega Cloudflare.
TRUSTED_PROXY_HOPS=1

# Secreto que autoriza POST /api/cron/<job> (ADR-19). Cadena aleatoria larga, una única vez.
CRON_SECRET=

# Secreto para firmar la cookie de sesión del admin (ADMIN_SPEC.md §1). Generar con una cadena aleatoria larga, una única vez.
SESSION_SECRET=

# SMTP para notificaciones (avisadores de búsqueda, alertas de admin). Proveedor de correo del propietario.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Número de WhatsApp general del sitio (contacto, no el de un vendedor), formato E.164.
WHATSAPP_SITE_NUMBER=

# Sólo desarrollo: habilita scripts/dev-fixtures.ts (publicaciones falsas con título "[DEV]").
# En producción NO debe existir (ADR-12, ADR-24). El script se niega a correr si falta,
# si NODE_ENV=production o si DATABASE_URL no apunta a localhost.
ALLOW_DEV_FIXTURES=

# ---------------------------------------------------------------------------
# Preparación automática al arrancar (src/lib/boot). Con esto no hace falta
# SSH, Remote MySQL ni cron de hPanel.
# ---------------------------------------------------------------------------
# Primer usuario admin: se crea sólo si todavía no existe ningún admin. Clave de 12+ caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# true = al arrancar, resetea la clave de ADMIN_EMAIL con ADMIN_PASSWORD y la desbloquea (sin SSH). Sacarla después.
ADMIN_PASSWORD_RESET=
# false = no correr migraciones, catálogo ni primer admin al arrancar.
AUTO_SETUP=
# false = apagar el programador interno de jobs (reintento de leads, vencimientos, limpieza).
INTERNAL_CRON=
# Código de verificación de Google Search Console (opcional, sólo el valor de content="…").
GOOGLE_SITE_VERIFICATION=
